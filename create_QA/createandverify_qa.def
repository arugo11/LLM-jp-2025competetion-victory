Bootstrap: docker
From: ghcr.io/astral-sh/uv:python3.12-bookworm-slim
Stage: builder

%setup
    mkdir ${SINGULARITY_ROOTFS}/app
    rsync -av --exclude-from=.dockerignore ./ ${SINGULARITY_ROOTFS}/app

    # Models are not copied into the image to avoid OOM and reduce build time.
    # They should be bind-mounted at runtime.

    # Create mount point for the uv cache
    mkdir -p ${SINGULARITY_ROOTFS}/root/.cache/uv

%post
    export UV_COMPILE_BYTECODE=1
    export UV_LINK_MODE=copy
    export UV_NO_EDITABLE=1
    export UV_FROZEN=1
    cd /app
    uv sync --no-dev

Bootstrap: docker
From: python:3.12-slim-bookworm
Stage: final


%setup
    #mkdir -p ${SINGULARITY_ROOTFS}/app/models/llm-jp/
    mkdir -p ${SINGULARITY_ROOTFS}/app/models/team-victory/
    # Models are not copied into the image to avoid OOM and reduce build time.
    # They should be bind-mounted at runtime.

    # Create mount point for the uv cache
    # (not used in final stage, but needed for --bind to work)
    mkdir -p ${SINGULARITY_ROOTFS}/root/.cache/uv

%files from builder
    /app /app

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        && rm -rf /var/lib/apt/lists/*

    chmod -R a+rX /app
    find /app -type f -name "*.py" -exec chmod a+r {} \;

%environment
    export PATH="/app/.venv/bin:$PATH"

%runscript
    cd /app
    
    QUESTIONS_FILE="output/intermediate_questions.jsonl"
    ANSWERS_FILE="output/intermediate_answers.jsonl"

    echo "=== Step 1: Create Questions ==="

    python3 create_questions.py "$@" --output_jsonl "$QUESTIONS_FILE"

    echo "=== Step 2: Create Answers ==="
    python3 create_answers.py "$@" --input_jsonl "$QUESTIONS_FILE" --output_jsonl "$ANSWERS_FILE"

    echo "=== Step 3: Verify QA ==="

    python3 verify_qa.py "$@" --input_jsonl "$ANSWERS_FILE" --max_token 1600